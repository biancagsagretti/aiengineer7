# --- Proveedor de modelos ---
LLM_PROVIDER=openai                 # openai | gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash
EMBEDDING_PROVIDER=openai
LLM_MAX_RETRIES=3

# --- API ---
API_KEY=                            # opcional: si se define, se exige el header X-API-Key
LOG_LEVEL=INFO

# --- Servicios (con Docker Compose usá estos nombres de host) ---
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=guitar_knowledge
VECTOR_SIZE=1536
REDIS_URL=redis://redis:6379/0
CHECKPOINTER_BACKEND=redis          # redis | memory (solo desarrollo)
WORKER_CONCURRENCY=5
JOB_TTL_SECONDS=604800

# --- Observabilidad (Arize Phoenix, HTTP) ---
PHOENIX_ENABLED=true
PHOENIX_COLLECTOR_ENDPOINT=http://phoenix:6006
PHOENIX_PROJECT_NAME=guitar-intelligence-system

# --- Visión y Human-in-the-loop ---
VISION_ENABLED=true
VISION_PAGE_RENDERS=true
VISION_MIN_INTERVAL=0               # 20 si tu cuenta tiene 3 RPM
VISION_MAX_PER_RUN=0
VISION_MIN_IMAGE_BYTES=8000
HITL_MIN_VISION_CALLS=1             # >= N llamadas de visión estimadas => requiere aprobación humana
# Supuestos para ESTIMAR el costo (revisá los precios vigentes de tu modelo):
VISION_EST_INPUT_TOKENS=1800
VISION_EST_OUTPUT_TOKENS=350
VISION_PRICE_IN_PER_MTOK=0.40
VISION_PRICE_OUT_PER_MTOK=1.60
